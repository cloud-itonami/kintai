;; Edge build for the Cloudflare Pages Function surface — mirrors
;; cloud-itonami-isic-6492's :edge-api build.
;; REBUILD: `amu compile --target wasm32-browser edge-api` — NOT `compile`.
{:deps {:aliases [:cljs]}
 :builds
 {:edge-api
  {:target :esm
   :output-dir "functions/edge"
   :modules {:kintai-edge-core
             {:exports {punchOnRequestPost kintai.edge.endpoints/on-request-post-punch}}}
   :compiler-options {:output-feature-set :es2020 :infer-externs :auto}}}}
