{:paths ["src"]
 :deps {io.github.kotoba-lang/langgraph
        {:git/sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}
        ;; Two capability libraries, deliberately separate. `shift` knows
        ;; how punches become worked spans; `worklaw` knows what a statute
        ;; permits. Keeping them apart is what lets the same statutory
        ;; rules be applied to timesheets that never came from a punch
        ;; clock. Both referenced by workspace-sibling path per the
        ;; fleet's capability-library-wrapping convention (same as
        ;; cloud-itonami-isco-4313 wraps kotoba-lang/labor).
        ;;
        ;; GIT deps, not sibling paths. A :local/root here made this repo
        ;; ungateable on the murakumo fleet, which ships one repo's tree and
        ;; no siblings, and made a fork need the whole kotoba-lang workspace
        ;; layout. Measured 2026-08-17 by parsing each library's deps.edn as
        ;; EDN: shift, worklaw and langchain-store all have zero :local/root
        ;; deps of their own. Verified by running this suite from a worktree
        ;; with no sibling directory in existence.
        io.github.kotoba-lang/shift
        {:git/url "https://github.com/kotoba-lang/shift.git"
         :git/sha "a31ac34eb2ad2f1bac1168a97dbf1cd0fffcff75"}
        io.github.kotoba-lang/worklaw
        {:git/url "https://github.com/kotoba-lang/worklaw.git"
         :git/sha "2e87a6ba258f3a7cc70bbea188ee1f9bbf59fede"}
        ;; shared langchain.db store seam (EDN-blob codec + identity
        ;; schema + seq-keyed event streams) — ADR-2607141600.
        io.github.kotoba-lang/langchain-store
        {:git/url "https://github.com/kotoba-lang/langchain-store.git"
         :git/sha "b986669f72276568c97e1fa5b331a5ff3017bf69"}
        ;; CACAO verification for the edge. Depended on, never
        ;; reimplemented (ADR-2607268000).
        io.github.kotoba-lang/org-chainagnostic-cacao
        {:git/url "https://github.com/kotoba-lang/org-chainagnostic-cacao.git"
         :git/sha "b395935018d97ee281c9b4564f855c8242b438e7"}
        io.github.kotoba-lang/governor
        {:git/url "https://github.com/kotoba-lang/governor.git"
         :git/sha "90a2944e617e58b9c90314b7e84b003ec3ea0c1f"}}
 :aliases
 {;; clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}
  ;; The :cljs branch of the edge ns. shadow-cljs.edn declares
  ;; :deps {:aliases [:cljs]}, so shadow itself has to be on THIS
  ;; classpath — `npm install` alone puts the launcher in node_modules
  ;; and the build then fails to locate shadow.cljs.devtools.cli.
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
